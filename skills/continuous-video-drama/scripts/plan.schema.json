{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/dramaforge/plan-v2.schema.json",
  "title": "DramaForge episode plan v2",
  "type": "object",
  "required": [
    "version",
    "seed",
    "segments"
  ],
  "properties": {
    "version": {
      "const": 2
    },
    "title": {
      "type": "string"
    },
    "seed": {
      "type": "integer"
    },
    "scene": {
      "type": "string"
    },
    "cast": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "frames",
          "start",
          "in_frame",
          "beats"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "frames": {
            "enum": [
              158,
              175,
              192,
              209,
              226,
              243,
              260,
              277,
              294,
              311,
              328,
              345,
              362
            ]
          },
          "start": {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "mode",
                  "asset"
                ],
                "properties": {
                  "mode": {
                    "const": "asset"
                  },
                  "asset": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": [
                  "mode"
                ],
                "properties": {
                  "mode": {
                    "const": "continue"
                  }
                },
                "additionalProperties": false
              }
            ]
          },
          "end_asset": {
            "type": "string"
          },
          "coverage_cut": {
            "type": "boolean"
          },
          "new_scene": {
            "type": "boolean"
          },
          "scene": {
            "type": "string"
          },
          "in_frame": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "offscreen": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "beats": {
            "type": "array",
            "minItems": 1,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "required": [
                    "action"
                  ],
                  "properties": {
                    "action": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "required": [
                    "say",
                    "text"
                  ],
                  "properties": {
                    "say": {
                      "type": "string"
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1
                    },
                    "to": {
                      "type": "string"
                    },
                    "manner": {
                      "type": "string"
                    },
                    "where": {
                      "type": "string"
                    },
                    "off": {
                      "type": "boolean"
                    }
                  },
                  "additionalProperties": false
                }
              ]
            }
          },
          "soundscape": {
            "type": "string"
          },
          "music": {
            "type": "string"
          }
        }
      }
    }
  }
}
